# PC Resolve — configuração do ambiente
# Copie este arquivo para ".env" e ajuste os valores.

# production (servidor) | local (desenvolvimento)
APP_ENV=production
# Exibe detalhes de erros na tela. Mantenha "false" em produção.
APP_DEBUG=false
# URL pública do site, sem barra no final (usada em sitemap, canonical e Open Graph)
APP_URL=https://www.seudominio.com.br
APP_TIMEZONE=America/Fortaleza

# Banco de dados MySQL / MariaDB
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pcresolve
DB_USERNAME=pcresolve
DB_PASSWORD=

# Sessão do painel administrativo (minutos de inatividade até sair)
SESSION_NAME=pcresolve_session
SESSION_LIFETIME=240

# Habilita o botão "Restaurar Padrão de Demonstração" nas Configurações.
# ATENÇÃO: apaga e recria serviços, solicitações, depoimentos, FAQ, cidades e configurações.
ALLOW_DEMO_RESET=false
