{
  "name": "pcresolve",
  "private": true,
  "version": "2.0.0",
  "description": "Build do CSS (Tailwind v4) do site PC Resolve em PHP. Não é necessário no servidor de produção.",
  "scripts": {
    "build": "tailwindcss -i resources/css/app.css -o public/assets/css/app.css --minify",
    "dev": "tailwindcss -i resources/css/app.css -o public/assets/css/app.css --watch"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^4.3.3"
  }
}
